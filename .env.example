# Application
APP_ENV=dev
APP_NAME=rag-parse
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Private service endpoints. Do not use real credentials in this file.
DATABASE_URL=postgresql+asyncpg://rag_parse:change-me@postgres:5432/rag_parse
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
S3_ENDPOINT=http://minio:9000
S3_BUCKET=rag-parse
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Model providers are disabled until an approved configuration is supplied.
MODEL_GATEWAY_ENABLED=false

# BFF
BFF_PORT=3000
BFF_CORE_API_URL=http://api:8000
